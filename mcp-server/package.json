{
  "name": "mpp32-mcp-server",
  "version": "1.8.0",
  "mcpName": "io.github.MPP32/mpp32-mcp-server",
  "description": "Payment layer for AI agents. One MCP, five protocols, thousands of paid APIs your agent can call.",
  "type": "module",
  "bin": {
    "mpp32-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "mpp",
    "mpp32",
    "machine-payments",
    "ai-agents",
    "agent-payments",
    "micropayments",
    "solana",
    "usdc",
    "x402",
    "tempo",
    "acp",
    "agent-commerce",
    "claude",
    "openai",
    "llm",
    "autonomous-agents",
    "crypto",
    "defi",
    "token-intelligence",
    "api-marketplace",
    "pivx",
    "governance",
    "dao"
  ],
  "license": "MIT",
  "author": "MPP32 <admin@mpp32.org> (https://mpp32.org)",
  "homepage": "https://mpp32.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/MPP32/MPP32"
  },
  "bugs": {
    "url": "https://github.com/MPP32/MPP32/issues"
  },
  "funding": "https://mpp32.org",
  "engines": {
    "node": ">=20.10.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@scure/base": "1.2.6",
    "@solana-program/compute-budget": "0.15.0",
    "@solana-program/token": "0.13.0",
    "@solana/kit": "6.9.0",
    "mppx": "0.4.12",
    "viem": "2.52.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.18",
    "typescript": "5.9.3"
  }
}
