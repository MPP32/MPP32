# MPP32 backend environment configuration.
#
# Copy this file to backend/.env (or set the same variables in your host
# platform's secret manager) and fill in production values. Never commit
# .env, .env.production, or .env.local. The root .gitignore enforces this.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Secrets ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# The backend refuses to boot in production if this is missing or matches a
# known-committed placeholder.
MPP_SECRET_KEY=

# Optional. Outbound email for contact form notifications.
RESEND_API_KEY=

# ── Public URLs ─────────────────────────────────────────────────────────────
BACKEND_URL=https://mpp32.org

# ── Payment protocols ───────────────────────────────────────────────────────
# Each protocol can be flipped independently. x402 is the production rail.
# Tempo, AP2, ACP, AGTP are wired but disabled until their client flows ship.
X402_ENABLED=true
TEMPO_ENABLED=false
AP2_ENABLED=false
ACP_ENABLED=false
AGTP_ENABLED=false

# ── x402 facilitator config ─────────────────────────────────────────────────
# The startup probe in backend/src/lib/x402.ts refuses to boot in production
# unless the configured facilitator advertises support for the configured
# network. PayAI's public facilitator supports Solana mainnet with no API key.
# Coinbase CDP also supports Solana mainnet but requires CDP API keys; set it
# here as the fallback for vendor redundancy.
X402_FACILITATOR_URL=https://facilitator.payai.network
X402_FACILITATOR_FALLBACK_URL=https://api.cdp.coinbase.com/platform/v2/x402
X402_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp

# Solana wallet that receives USDC settlements for the MPP32 Intelligence
# Oracle. Must be a Solana mainnet address with an existing USDC ATA.
X402_RECIPIENT_ADDRESS=

# Solana RPC endpoint used for M32 balance lookups. Public mainnet RPC is the
# default; swap in a Helius or QuickNode URL for production traffic.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── M32 token gate ──────────────────────────────────────────────────────────
# Mint address for the M32 token (used by the m32-gated endpoints).
M32_TOKEN_MINT=6hKtz8FV7cAQMrbjcBZeTQAcrYep3WCM83164JpJpump

# Hold-tier discount on the Intelligence Oracle. Stays off until SIWS wallet
# signature verification ships. Without SIWS, the X-Wallet-Address header is
# spoofable and the discount could be claimed by anyone.
M32_DISCOUNT_ENABLED=false

# ── Tempo configuration (only used when TEMPO_ENABLED=true) ─────────────────
TEMPO_RECIPIENT_ADDRESS=
TEMPO_CURRENCY_ADDRESS=

# ── Optional ────────────────────────────────────────────────────────────────
# Email address that contact form submissions notify.
CONTACT_NOTIFY_EMAIL=

# Override price per query for the Intelligence Oracle (USD, decimal string).
MPP_PRICE=0.008
